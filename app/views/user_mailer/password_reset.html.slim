tr
  td bgcolor="#ffffff" style="padding: 30px 20px; font-family: Arial, sans-serif; line-height: 1.6;"
    h2 style="margin-top: 0; margin-bottom: 15px;" Password Reset Request
    p style="margin-bottom: 15px;" Click the link below to reset your password:
    p style="margin-bottom: 20px; text-align: center;"
      = link_to 'Reset Password', \
                edit_password_reset_url(@reset.token), \
                style: 'display: inline-block; background: #3F52B5; color: white; padding: 12px 25px; text-decoration: none; border-radius: 4px; font-weight: bold;'
    p style="color: #777; font-size: 13px; margin-top: 25px;"
      em This link expires in 24 hours. If you didn't request a password reset, please ignore this email.
